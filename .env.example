# ------------------------------------------------------------------
# Kargo Operasyon Platformu — Environment Variables (örnek)
# Gerçek secret değerlerini ASLA bu dosyaya yazma.
# Bu dosyayı kopyalayıp `.env.local` oluştur ve değerleri doldur.
# ------------------------------------------------------------------

# --- Uygulama ---
# Production: gerçek production domain (coğrafi örnek placeholder DEĞİL).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Veritabanı (Supabase PostgreSQL) ---
# Production: Supabase pooled connection URL
# https://supabase.com/docs/guides/database/connecting-to-postgres#connection-pooler
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kargo
# Migration/yönetim işlemleri için direct connection (opsiyonel, serverless'te gerekli)
DIRECT_URL=

# --- Kimlik doğrulama (JWT ile session yönetimi) ---
# `openssl rand -base64 32` ile güçlü bir değer üret
AUTH_SECRET=

# --- İki Aşamalı Doğrulama (2FA) Gizli Anahtar Şifreleme ---
# MFA secret'ları veritabanında düz metin olarak tutmamak için kullanılan anahtar.
# AES-256-GCM formatı için 32 byte (256-bit) uzunluğunda olmalı.
# `openssl rand -hex 32` ile güçlü bir değer üretip atayın.
MFA_ENCRYPTION_KEY=

# --- Webhook imzalama (yalnız provider HMAC-shared-secret destekliyorsa) ---
# `openssl rand -hex 32` ile üret.
WEBHOOK_SECRET=

# --- Kargo firmaları (config-driven; girildiğinde aktifleşir) ---
# Aras/DHL/HepsiJET/PTT için resmi API dokümanı + production credential
# temin edilene kadar entegrasyonlar "Doküman Bekleniyor" durumunda kalır.
# (Resmi sözleşme olmadan endpoint uydurulmaz.) Resmi credential girildiğinde
# gerçek integration kod yolu aktifleştirilebilir.
ARAS_API_URL=
ARAS_API_KEY=
ARAS_API_SECRET=

DHL_API_URL=
DHL_API_KEY=
DHL_API_SECRET=

HEPSIJET_API_URL=
HEPSIJET_API_KEY=
HEPSIJET_API_SECRET=

PTT_API_URL=
PTT_API_KEY=
PTT_API_SECRET=

# --- Netgsm SMS ---
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=

# --- Geliştirme/test (production'da ASLA açma) ---
# true iken dev ortamında sahte kargo provider'ı aktifleşir.
# NODE_ENV=production iken bu ayar yoksayılır.
ENABLE_FAKE_CARGO_PROVIDER=false
